# Copie para .env e ajuste. NUNCA commite o .env (ele está no .gitignore).
# Todos os valores abaixo são exemplos fictícios.

# Perfil: dev (local), prod (produção). O perfil test é usado só pelos testes.
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskbridge
DB_USER=taskbridge
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Em produção com MySQL gerenciado, use VERIFY_IDENTITY (TLS com verificação do certificado).
DB_SSL_MODE=PREFERRED

# MOCK: PIX simulado (padrão). REAL: exige implementar um adapter para um PSP — ver docs/PAGAMENTOS.md.
PAYMENT_MODE=MOCK
# Habilita "simular pagamento/expiração/cancelamento". Ignorado no perfil prod.
PAYMENT_DEBUG_ENABLED=true
# Só usada por um futuro adapter REAL. O modo MOCK usa sempre uma chave de teste fixa (.invalid).
PIX_KEY=TEST-ONLY

# Origens extras liberadas no CORS (separadas por vírgula). Vazio = só a própria origem.
CORS_ALLOWED_ORIGINS=

STORAGE_DIR=./data/uploads

# Não há JWT_SECRET: a autenticação é por sessão (cookie HttpOnly) + CSRF. Ver docs/ARQUITETURA.md §8.

# Login com Google/GitHub (opcional). Cada provedor só aparece se as duas variáveis estiverem preenchidas.
# Google: console.cloud.google.com › APIs e serviços › Credenciais › ID do cliente OAuth (Aplicativo da Web)
# GitHub: github.com › Settings › Developer settings › OAuth Apps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Endereço público do site (sem barra no final). Os provedores voltam para APP_BASE_URL/login/oauth2/code/{google|github}.
APP_BASE_URL=
